{
  "manifest_version": 2,
  "name": "MPRIS Tab Bridge",
  "version": "1.1.5",
  "description": "Independent Linux MPRIS controls for each media tab, with current YouTube metadata and reliable tab lifecycle. Requires a native helper.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mpris-tab-bridge@frixlt.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "https://i.ytimg.com/*",
    "https://static-cdn.jtvnw.net/*"
  ],
  "background": {
    "scripts": [
      "artwork.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media-metadata.js",
        "media-volume.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "homepage_url": "https://github.com/Frixlt/mpris-bridge"
}
